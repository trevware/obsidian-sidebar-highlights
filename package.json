		"@types/node": "^16.11.6",
		"esbuild": "0.17.3",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"obsidian": "latest",
		"stylelint": "^17.16.0",
		"stylelint-config-obsidianmd": "^0.1.0",
		"ts-jest": "^29.1.1",
		"tslib": "2.4.0",
		"typescript": "^4.9.5",
		"typescript-eslint": "^8.67.0"
	}
