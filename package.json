	"description": "Collect every highlight, comment and task in your vault into one sidebar. Sort highlights into collections and plan your tasks by day.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"lint": "eslint . && stylelint styles.css",
