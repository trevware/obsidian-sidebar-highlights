# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# Local development notes
CHECKLIST.md

# Testing and backups
TESTING.md
backups/
test-*.js

# Runtime restore audit log (rewritten by the plugin on every restore)
restore-log.txt

# Local hot-reload marker (not for distribution)
.hotreload
